# 复制为 .env 后由你自己的进程管理器注入。映流不会自动读取 .env。
# 这些变量会覆盖 config.toml 和网页里保存的同名字段。

REELPRESS_DATA_DIR=data
REELPRESS_LLM_BASE_URL=https://api.deepseek.com/v1
REELPRESS_LLM_MODEL=deepseek-chat
REELPRESS_LLM_API_KEY=
REELPRESS_PEXELS_API_KEY=
REELPRESS_PIXABAY_API_KEY=
REELPRESS_VISUAL_AI_BASE_URL=
REELPRESS_VISUAL_AI_API_KEY=
REELPRESS_YOUTUBE_CLIENT_ID=
REELPRESS_YOUTUBE_CLIENT_SECRET=
REELPRESS_TTS_VOICE=zh-CN-XiaoxiaoNeural
REELPRESS_UPLOAD_CDP_URL=
